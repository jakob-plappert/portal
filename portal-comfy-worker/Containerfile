FROM pytorch/pytorch:2.12.0-cuda13.0-cudnn9-runtime

RUN apt-get update \
    && apt-get install -y git python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt

RUN git clone --depth 1 https://github.com/Comfy-Org/ComfyUI.git

WORKDIR /opt/ComfyUI

RUN python3 -m venv --system-site-packages /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

RUN git clone --depth 1 https://github.com/city96/ComfyUI-GGUF.git \
        custom_nodes/ComfyUI-GGUF \
    && /opt/venv/bin/pip install --no-cache-dir \
        -r custom_nodes/ComfyUI-GGUF/requirements.txt

COPY extra_model_paths.yaml /opt/ComfyUI/extra_model_paths.yaml

CMD ["/opt/venv/bin/python", "main.py", "--listen", "0.0.0.0", "--port", "8188", "--output-directory", "/output"]
